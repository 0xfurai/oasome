{
  "components": {
    "schemas": {
      "CreateUserReq": {
        "properties": {
          "name": {
            "description": "Display name",
            "example": "Ada",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "User": {
        "examples": [
          {
            "id": "u_42",
            "name": "Ada",
            "role": "admin"
          }
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "license": {
      "name": "MIT"
    },
    "title": "My API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/users/{id}": {
      "get": {
        "description": "Returns one user by ID.",
        "operationId": "getUser",
        "parameters": [
          {
            "description": "User ID",
            "example": "u_42",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Request trace ID",
            "in": "header",
            "name": "X-Trace-ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Comma-separated fields to return",
            "example": "id,name",
            "in": "query",
            "name": "fields",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Get a user",
        "tags": [
          "users"
        ]
      },
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Created"
          }
        }
      }
    }
  }
}
